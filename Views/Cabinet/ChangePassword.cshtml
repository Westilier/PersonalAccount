@model PasswordChangeViewModel

@{
    ViewData["Title"] = "Изменение пароля";
}

<div class="container">
    <div class="d-flex justify-content-between align-content-center">
        <h1 class="mb-4">Изменение пароля</h1>
    </div>

    <form id="passwordForm" class="card-body" method="post" asp-action="ChangePassword" asp-controller="Cabinet">
        <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="OldPassword"></label>
            <input class="form-control" id="oldPassword" type="password" asp-for="OldPassword" />
            <span class="text-danger small" asp-validation-for="OldPassword"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="NewPassword"></label>
            <input class="form-control" id="newPassword" type="password" asp-for="NewPassword" />
            <span class="text-danger small" id="newPasswordError"  asp-validation-for="NewPassword"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Подвердите пароль</label>
            <input class="form-control" id="confirmPassword" type="password" />
            <span class="text-danger small" id="confirmError"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">Изменить</button>
    </form>
</div>
@section Scripts {
    <script src="~/js/password-check.js" asp-append-version="true"></script>
}