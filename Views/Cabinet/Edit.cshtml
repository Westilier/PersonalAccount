@model StudentEditViewModel

@{
    ViewData["Title"] = "Редактирование";
}

<div class="container">
    <div class="d-flex justify-content-between align-content-center">
        <h1 class="mb-4">Редактирование</h1>
    </div>

    <form class="card-body" method="post" asp-action="Edit" asp-controller="Cabinet"> 
        <div class="mb-3">
            <label class="form-label" asp-for="PhotoUrl"></label>
            <input class="form-control" asp-for="PhotoUrl"/>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="FullName"></label>
            <input class="form-control" asp-for="FullName" />
            <span class="text-danger small" asp-validation-for="FullName"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="GroupName"></label>
            <input class="form-control" asp-for="GroupName"/>
            <span class="text-danger small" asp-validation-for="GroupName"></span>
        </div>

        <button class="btn btn-primary w-100 mb-3" type="submit" formmethod="get" formaction="@Url.Action("ChangePassword", "Cabinet")">
            Сменить пароль
        </button>

        <button class="btn btn-primary w-100" type="submit">Сохранить</button>
    </form>
</div>

    