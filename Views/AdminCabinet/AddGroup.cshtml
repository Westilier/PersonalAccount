@model AddGroupViewModel

@{
    ViewData["Title"] = "Создание Группы";
}

<div class="container d-flex align-content-center justify-content-center">
    <div class="card w-50">
        <header class="card-header">
            <h1 class="text-center">
                Создание новой группы
            </h1>
        </header>
        <form class="card-body" method="post">

            <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
            
            <div class="mb-3">
                <label class="form-label" asp-for="Name"></label>
                <input class="form-control" asp-for="Name" autocomplete="off" />
                <span class="text-danger small" asp-validation-for="Name"></span>
            </div>
            
            <div class="mb-3">
                <label class="form-label" asp-for="Description"></label>
                <input class="form-control" asp-for="Description" autocomplete="off" />
            </div>
            
            <div class="mb-3">
                <label class="form-label" asp-for="ImageUrl"></label>
                <input class="form-control" asp-for="ImageUrl" autocomplete="off" />
            </div>

            <button class="btn btn-primary w-100" type="submit">Создать</button>

        </form>
    </div>
</div>


