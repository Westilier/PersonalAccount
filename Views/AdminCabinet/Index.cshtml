@model AdminCabinetViewModel

@{
    ViewData["Title"] = "Панель администратора";
}

<div class="container">
    <div class="d-flex justify-content-between align-content-center">
        <h1 class="mb-4">Панель администратора</h1>
    </div>

    <div class="container d-flex flex-column align-items-stretch gap-5">
        @foreach (var groupId in Model.GroupIdsOrder)
        {
            var groupInfo = Model.GroupInfos[groupId];

            <div class="container d-flex flex-column align-items-stretch gap-2">
                <div class="card d-flex align-items-start justify-content-center p-5"
                        style="height: 100px; background-color: #2b2f32; background-image: url(@groupInfo.ImageUrl); background-size: cover">
                    <h3 class=" text-center text-white  fw-bold">
                        @groupInfo.Name
                    </h3>
                    @if (groupId != -1)
                    {
                        <form method="post" asp-action="DeleteGroup" class="position-absolute end-0 top-50 translate-middle-y me-4">
                            <input type="hidden" name="groupId" value="@groupId" />
                            <button type="submit" class="btn btn-sm btn-danger px-3 shadow-sm d-flex align-items-center gap-1 opacity-75 hover-opacity-100"
                                    onclick="return confirm('Вы уверены, что хотите удалить группу «@groupInfo.Name»?');">
                                <span>🗑️</span> Удалить
                            </button>
                        </form>
                    }
                </div>
                <span class="text-primary text-start text-wrap">@groupInfo.Description</span>
                <div class="container d-flex flex-wrap gap-4">
                    
                    @if (Model.StudentInfos.TryGetValue(groupId, out var studentInfos))
                    {
                        @foreach (var studentInfo in studentInfos)
                        {
                            <div class="card" style="width: 400px">
                                <div class="gap-2 d-grid align-items-stretch" style="grid-template-columns: repeat(2, 1fr)">
                                    <div class="w-100 h-100"
                                            style="background-image: url(@studentInfo.PhotoUrl); background-size: cover">
                                    </div>
                                    <div class="d-flex flex-column gap-2 w-100 h-100">
                                        <p class="card-header">
                                            @studentInfo.FullName
                                        </p>
                                        <p>
                                            @studentInfo.Email
                                        </p>
                                    </div>
                                </div>
                                <div class="bg-light p-3 border-top mt-auto">
                                    <form method="post" asp-action="ChangeStudentGroup" class="d-flex flex-column gap-2">
                                        <input type="hidden" name="studentAccountId" value="@studentInfo.AccountId" />
                                        <div class="input-group input-group-sm">
                                            <label class="input-group-text bg-white text-secondary small" for="select-@studentInfo.AccountId">Группа</label>
                                            <select class="form-select text-dark fw-medium" name="groupId" id="select-@studentInfo.AccountId">
                                                @foreach (var gId in Model.GroupIdsOrder)
                                                {
                                                    var group = Model.GroupInfos.GetValueOrDefault(gId);
                                                    if (group == null) continue;
                        
                                                    <option value="@gId" selected="@(gId == studentInfo.GroupId)">
                                                        @group.Name
                                                    </option>
                                                }
                                            </select>
                                        </div>
           
                                        <button type="submit" class="btn btn-sm btn-primary w-100 fw-semibold shadow-sm">
                                            Сменить группу
                                        </button>
                                    </form>
                                </div>
                                <form method="post" asp-action="DeleteStudent" class="m-3">
                                    <input type="hidden" name="studentAccountId" value="@studentInfo.AccountId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger h-100 px-3 shadow-sm" title="Удаление студента"
                                            onclick="return confirm('Вы уверены, что хотите полностью удалить студента «@studentInfo.FullName»?');">
                                        <span>🗑️</span> Удалить
                                    </button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>         
        }
        <div class="container d-flex flex-column gap-4 mt-4">
            <div class="card bg-dark text-white p-4 shadow-sm border-0">
                <h3 class="m-0 text-center fw-bold">Дисциплины</h3>
            </div>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var subject in Model.Subjects)
                {
                    <div class="card shadow-sm border-0 p-3 flex-grow-1" style="min-width: 250px; max-width: 400px;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-secondary">📚</span>
                            <span class="fw-semibold text-dark">@subject.Name</span>
                            <form class="card" style="width: 400px" method="post" asp-action="DeleteSubject">
                                <input type="hidden" name="subjectId" value="@subject.Id" />
                                <button class="w-100 h-100 btn btn-outline-primary"
                                        onclick="return confirm('Вы уверены, что хотите удалить дисциплину «@subject»?');">
                                        Удалить
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="d-flex gap-4">
            <form class="card" style="width: 400px" method="get" asp-action="RegisterStudent">
                <button class="w-100 h-100 btn btn-outline-primary">Зарегистрировать студента</button>
            </form>
            <form class="card" style="width: 400px" method="get" asp-action="AddGroup">
                <button class="w-100 h-100 btn btn-outline-primary">Создать группу</button>
            </form>
            <form class="card" style="width: 400px" method="get" asp-action="AddSubject">
                <button class="w-100 h-100 btn btn-outline-primary">Создать дисциплину</button>
            </form>
        </div>
    </div>
</div>